# Maddie Journey private service — EXAMPLE ONLY. Copy to a private location
# (never commit the real file) and supply values through your host's secret store.

# Viewer access (existing Google identities; no new accounts)
MJ_PUBLIC_ORIGIN=https://maddie-journey-private.example.internal
MJ_SESSION_SECRET=replace-with-at-least-32-random-characters
MJ_GOOGLE_SIGNIN_CLIENT_ID=000000000000-example.apps.googleusercontent.com
MJ_ALLOWED_VIEWERS=hr.viewer@example.com,coo.viewer@example.com
# MJ_INSECURE_LOCAL_COOKIES=1   # only for http://localhost testing

# Airtable — fine-grained personal access token with ONLY data.records:read
# and schema.bases:read on the P&C Operations base.
MJ_AIRTABLE_TOKEN=
MJ_AIRTABLE_BASE_ID=

# Google read-only OAuth (optional; enables Sheets masterlist reconciliation and Calendar)
# Scopes: spreadsheets.readonly, drive.metadata.readonly, calendar.readonly
MJ_GOOGLE_OAUTH_CLIENT_ID=
MJ_GOOGLE_OAUTH_CLIENT_SECRET=
MJ_GOOGLE_OAUTH_REFRESH_TOKEN=
MJ_SHEETS_MASTERLIST_ID=
MJ_SHEETS_MASTERLIST_TAB=Masterlist
MJ_CALENDAR_ID=

MJ_STALE_AFTER_MINUTES=15
